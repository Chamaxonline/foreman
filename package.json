{
  "name": "claude-foreman",
  "version": "0.2.0",
  "description": "Autonomous orchestrator: turns an idea into a story and a clickable prototype, then builds approved work with Claude, verifies it with your real checks, and opens GitHub or Azure DevOps PRs.",
  "type": "module",
  "license": "MIT",
  "author": "chamathran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chamaxonline/foreman.git"
  },
  "homepage": "https://github.com/Chamaxonline/foreman#readme",
  "bugs": {
    "url": "https://github.com/Chamaxonline/foreman/issues"
  },
  "keywords": [
    "claude",
    "agent",
    "orchestrator",
    "github",
    "azure-devops",
    "automation",
    "pull-request",
    "prototype"
  ],
  "bin": {
    "foreman": "dist/cli.js",
    "claude-foreman": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
