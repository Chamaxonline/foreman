{
  "name": "claude-foreman",
  "version": "0.1.0",
  "description": "Autonomous orchestrator: takes software tasks, executes them with Claude, verifies the result, and opens GitHub PRs.",
  "type": "module",
  "license": "MIT",
  "author": "chamathran",
  "keywords": [
    "claude",
    "agent",
    "orchestrator",
    "github",
    "automation",
    "pull-request"
  ],
  "bin": {
    "foreman": "dist/cli.js",
    "claude-foreman": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
